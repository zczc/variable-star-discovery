  "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>TESS Light Curve Explorer</title>\n  <link rel=\"stylesheet\" href=\"assets/base.css?v=6\">\n  <link rel=\"stylesheet\" href=\"assets/pages.css?v=6\">\n</head>\n<body data-page=\"som\">\n\n  <div class=\"page\">\n    <div class=\"site-header\">\n      <a class=\"site-logo-link\" href=\"index.html\">\n        <img class=\"site-logo\" src=\"img/tess-l8.logo.png\" alt=\"TESS-L8 logo\">\n      </a>\n      <div class=\"site-title-wrap\">\n        <h1 class=\"site-title\">TESS Light Curve 8xplorer</h1>\n      </div>\n    </div>\n\n    <div class=\"top-grid\">\n      <aside class=\"sidebar\">\n        <section class=\"panel\">\n          <h2>Search</h2>\n          <div class=\"search-row\">\n            <input id=\"tic-input\" type=\"text\" placeholder=\"TIC\">\n          </div>\n          <div class=\"search-row\">\n            <input id=\"sector-input\" type=\"text\" placeholder=\"Sector (optional)\">\n          </div>\n          <div class=\"search-row\">\n            <button id=\"search-btn\" type=\"button\">Go</button>\n          </div>\n          <div id=\"search-message\" class=\"search-message\"></div>\n        </section>\n\n        <section class=\"panel\">\n          <h2>Explore SOM</h2>\n\n          <div class=\"control-group\">\n            <label for=\"metric\">Color map by</label>\n            <select id=\"metric\"></select>\n          </div>\n\n          <div class=\"control-group\">\n            <label for=\"log-mode\">Transform</label>\n            <select id=\"log-mode\">\n              <option value=\"off\">linear</option>\n              <option value=\"on\" selected>log10</option>\n            </select>\n          </div>\n\n          <div class=\"control-group\">\n            <label for=\"label-mode\">Hex labels</label>\n            <select id=\"label-mode\">\n              <option value=\"none\">no labels</option>\n              <option value=\"node\" selected>node number</option>\n              <option value=\"value\">feature value</option>\n            </select>\n          </div>\n        </section>\n      </aside>\n\n      <main class=\"maincol\">\n        <section class=\"panel\">\n          <div id=\"colorbar\"></div>\n          <div id=\"som\"></div>\n        </section>\n      </main>\n    </div>\n\n    <section class=\"panel notes\">\n      <h2>About this map</h2>\n      <p>\n        We process about 95% of the light curves in the <a href=\"https://archive.stsci.edu/missions-and-data/tess\" target=\"_blank\" rel=\"noopener noreferrer\">TESS</a>\n        2mn-cadence catalog, that pass minimal quality criteria, about 1.5M light curves, of about 500K indivisual stars, obtained from\n        <a href=\"https://mast.stsci.edu/portal/Mashup/Clients/Mast/Portal.html\" target=\"_blank\" rel=\"noopener noreferrer\">MAST</a>.\n        We map them in a semi-supervised fashion to a Self Organizing Map (SOM). The map is organized by variability amplitude, frequency and morphology.\n        <br>\n        <br>\n        Each hexagon is a SOM node that groups similar light curves.\n        <br>\n        In every node the light curves are ranked by proximity to the node's Best Matching Unit (BMU) in the training set.\n        <br>\n        <br>\n        Click a node to open its node page.\n        <br>\n        Use the search box to jump to a TIC page, or to a TIC-sector light-curve page.\n      </p>\n      <p>\n        For details, see Poznanski (2026). Website created by\n\t\t<a href=\"mailto:dovi@tau.ac.il?subject=TESS-L8\" target=\"_blank\" rel=\"noopener noreferrer\">Dovi Poznanski</a>. Questions and comments welcome. \n      </p>\n    </section>\n\n  </div>\n\n  <script src=\"assets/common.js?v=6\"></script>\n  <script src=\"assets/plot.js?v=6\"></script>\n  <script src=\"assets/som.js?v=6\"></script>\n  <script src=\"assets/pages.js?v=6\"></script>\n\n  <!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{\"token\": \"89f8a7994cc3456d8c9ac8647a45b3bb\"}'></script><!-- End Cloudflare Web Analytics -->\n\n  <script data-goatcounter=\"https://tess-l8.goatcounter.com/count\"\n        async src=\"//gc.zgo.at/count.js\"></script>\n\n  \n</body>\n</html>\n"
}