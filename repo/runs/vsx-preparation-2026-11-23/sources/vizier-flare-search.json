n title='TD1' >TD1</option><option title='TESS' >TESS</option><option title='UIT' >UIT</option><option title='ULYSSES' >ULYSSES</option><option title='WISE' >WISE</option><option title='WMAP' >WMAP</option><option title='WUPPE' >WUPPE</option><option title='XMM' >XMM</option></SELECT>\n </TD><TD ALIGN=LEFT NOWRAP><div ><span class='title'>&nbsp;</span><span class='Vcol5 headstring'>Astronomy</span></div><SELECT NAME=\"-kw.Astronomy\" MULTIPLE SIZE=7 width='100%' onChange='vmine()'><option title='Abundances' >Abundances</option><option title='Ages' >Ages</option><option title='AGN' >AGN</option><option title='Associations' >Associations</option><option title='Asteroseismology' >Asteroseismology</option><option title='Atomic_Data' >Atomic_Data</option><option title='Binaries:cataclysmic' >Binaries:cataclysmic</option><option title='Binaries:eclipsing' >Binaries:eclipsing</option><option title='Binaries:spectroscopic' >Binaries:spectroscopic</option><option title='Black_Holes' >Black_Holes</option><option title='BL_Lac_objects' >BL_Lac_objects</option><option title='Blue_objects' >Blue_objects</option><option title='Clusters_of_galaxies' >Clusters_of_galaxies</option><option title='Constellations' >Constellations</option><option title='Diameters' >Diameters</option><option title='Earth' >Earth</option><option title='Ephemerides' >Ephemerides</option><option title='Equivalent_widths' >Equivalent_widths</option><option title='Exoplanets' >Exoplanets</option>\n\t<option title='Extinction' >Extinction</option><option title='Galaxies' >Galaxies</option><option title='Galaxies:Markarian' >Galaxies:Markarian</option><option title='Galaxies:spectra' >Galaxies:spectra</option><option title='Globular_Clusters' >Globular_Clusters</option><option title='Gravitational_lensing' >Gravitational_lensing</option><option title='Gravitational_wave' >Gravitational_wave</option><option title='GRB' >GRB</option><option title='HII_regions' >HII_regions</option><option title='Intergalactic_medium' >Intergalactic_medium</option><option title='Interstellar_Medium' >Interstellar_Medium</option><option title='Magnetic_fields' >Magnetic_fields</option><option title='Masers' >Masers</option><option title='Masses' >Masses</option><option title='_META_' >_META_</option><option title='Models' >Models</option><option title='Molecular_Data' >Molecular_Data</option><option title='Multiple_Stars' >Multiple_Stars</option><option title='Nebulae' >Nebulae</option><option title='Neutrino' >Neutrino</option>\n\t<option title='Nonstellar' >Nonstellar</option><option title='Novae' >Novae</option><option title='Obs_Log' >Obs_Log</option><option title='Open_Clusters' >Open_Clusters</option><option title='Orbits' >Orbits</option><option title='Parallaxes' >Parallaxes</option><option title='Photometry' >Photometry</option><option title='Photometry:intermediate-band' >Photometry:intermediate-band</option><option title='Photometry:narrow-band' >Photometry:narrow-band</option><option title='Photometry:surface' >Photometry:surface</option><option title='Photometry:wide-band' >Photometry:wide-band</option><option title='Planetary_Nebulae' >Planetary_Nebulae</option><option title='Planets+Asteroids' >Planets+Asteroids</option><option title='Polarization' >Polarization</option><option title='Positional_Data' >Positional_Data</option><option title='Proper_Motions' >Proper_Motions</option><option title='Pulsars' >Pulsars</option><option title='QSOs' >QSOs</option><option title='Redshifts' >Redshifts</option><option title='Rotational_Velocities' >Rotational_Velocities</option>\n\t<option title='Seyfert_Galaxies' >Seyfert_Galaxies</option><option title='Spectral_Classification' >Spectral_Classification</option><option title='Spectrophotometry' >Spectrophotometry</option><option title='Spectroscopy' >Spectroscopy</option><option title='Star_Forming_Region' >Star_Forming_Region</option><option title='Stars' >Stars</option><option title='Stars:brown_dwarf' >Stars:brown_dwarf</option><option title='Stars:early-type' >Stars:early-type</option><option title='Stars:Emission' >Stars:Emission</option><option title='Stars:late-type' >Stars:late-type</option><option title='Stars:peculiar' >Stars:peculiar</option><option title='Stars:variable' >Stars:variable</option><option title='Stars:white_dwarf' >Stars:white_dwarf</option><option title='Stars:WR' >Stars:WR</option><option title='Sun' >Sun</option><option title='SuperNovae' >SuperNovae</option><option title='SuperNovae_Remnants' >SuperNovae_Remnants</option><option title='Transient' >Transient</option><option title='Velocities' >Velocities</option><option title='YSOs' >YSOs</option></SELECT>\n</TD></TR></TABLE>\n</TD></TR><TR><TD ALIGN=LEFT NOWRAP  valign='bottom'><div id='select_ucd'><span class='actaref in hidden' title='Select Catalogs having columns with specific Unified Content Descriptor' href='javascript:void(0)' onClick='showucd()'> Hide </span><span class='actaref out' title='Select Catalogs having columns with specific Unified Content Descriptor' href='javascript:void(0)' onClick='showucd()'> Search for </span>catalogs by column descriptions<span class='note'> (UCD)<A title='UCD help' onClick=\"vHelp('1.htx#ucd')\" href='javascript:void(0)'><img src='/vizier/help.png' alt='usage' class='helpimg'></A></span></div>\n</TD></TR></TABLE>\n</div>\n\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/vizier/lib/ucd2/ucd2.css\">\n<script type='text/javascript' src='/vizier/lib/ucd2/ucd2.js'></script>\n\n<script type='text/javascript'>\nfunction ucdaddexample(o){\n  var ucd=$(o).parent().find('span');\n  if (ucd.length==0) ucd=$(o).parent().parent().find(\"td[class='ucdid']\");\n  ucd=ucd.eq(0).html();\n  if (! $(o).attr(\"checked\")){\n    var input=$(\"form[name='form0'] input[name='-ucd']\");\n    if (input.length<1) return ;\n    ucd=\"(\"+ucd+\")\";\n    var r=\"|\"+ucd; input.val(input.val().replace(r,\"\"));\n    r=\"&\"+ucd; input.val(input.val().replace(r,\"\"));\n    input.val(input.val().replace(ucd,\"\"));\n    input.val(input.val().replace(/^[|&]/,\"\"));\n    vmine();\n  }\n  else ucdadd(\"(\"+ucd+\")\",\"&\");\n}\nfunction ucdadd(ucd,logic){\n  var input=document.getElementById(\"ucd2search\");\n  if (!input) return;\n  if ($(input).val().search(/[.*;A-Z]/)==-1) $(input).val(\"\");\n  verifyucdsyntax(input);\n  if ($(input).length<1) return ;\n  if ($(input).val()) $(input).val($(input).val()+logic+ucd);\n  else $(input).val(ucd);\n  vmine();\n}\nfunction ucdclear(){\n  $(\"form[name='form0'] input[name='//not']\").removeAttr(\"checked\");\n  e=$(\"form[name='form0'] input[name='-ucd']\");\n  e.val(\"\");\n  e.removeClass(\"unknownvalue\");\n}\n\nfunction ucddisplay(id){\n  var i;\n  $(\"#ucd2core div\").each(function(i){\n      if ($(this).hasClass('subsection')) $(this).addClass('hidden');});\n  $(\"#\"+id).removeClass('hidden');\n}\n\nfunction ucdinit(){\n  $(\"#ucd2core input[name='//ucdform']\").attr(\"checked\",false);\n  $(\"#ucd2core input[name='//ucdform']\").eq(0).attr(\"checked\",true);\n}\n\nfunction verifyucdsyntax(e){\n   if ($(e).val().search(/[.*+]/)<0)\n     $(e).addClass(\"unknownvalue\");\n   else $(e).removeClass(\"unknownvalue\");\n   if ($(e).val().length==0)\n     $(e).removeClass(\"unknownvalue\");\n\n   if ($(e).hasClass(\"unknownvalue\")) return false;\n\n   while ($(e).val().search(/[ \\t]/)>-1)\n     $(e).val($(e).val().replace(/[ \\t]/,\"\"));\n   return true;\n}\n\nvar ucd2_list;\nvar ucd2_lock=0;\nvar ucd2_time;\n\nfunction ucd2_createArray(diva,table){\n  var i,tr,td,j;\n  var data=table.find('DATA TABLEDATA');\n  var ucdArray=new Array(); ucdArray.push('UCD!!!');\n  var depth,crtDepth=-1,nextDepth;\n  var lArray=new Array();\n \n  if (data.length==0) { \n    ucd2_error(diva,'error with votable format: DATA>TABLEDATA');\n    return; }\n\n  tr=data.find('tr');\n  diva.html(\"<b>(\"+tr.length+\" definitions available)</b><br>\");\n\n  for(i=0;i<tr.length;i++){\n    td=tr.eq(i).find('td'); \n    if (td.eq(0).text()!=\"\"){\n      var ucd,it,ex;\n      ucd=td.eq(1).text().replace(/ +/,'');\n      depth=td.eq(0).text();\n      if (depth<crtDepth)\n        for (j=0;j<crtDepth-depth;j++) lArray.pop();\n      \n      if ((i+1)<tr.length) { // create a new array if the next value is a subnode\n        nextDepth=tr.eq(i+1).find('td').eq(0).text();\n      }\n      else nextDepth=-1;\n\n      if (nextDepth>depth) {\n        var a=new Array();\n        if (lArray.length>0) {lArray[lArray.length-1].push(a);lArray.push(a);}\n        else {lArray.push(new Array());ucdArray.push(lArray[0]);}\n      }\n\n      if (td.eq(2).text()!=\"\"){\n        ex=td.eq(2).text().replace(/ +$/,'');;\n      }\n      else ex='-';\n      if (td.eq(3).text()!=\"\") it=td.eq(3).text();\n      else it='-';\n\n      // add - before ucdname for looking all sub ucd (ie: -ucd=!ucd*)\n      if (td.eq(4).text()!=\"\") j=td.eq(4).text();\n      else j=0;\n\n      if (lArray.length>0)lArray[lArray.length-1].push(ucd+'!'+j+'!'+it+'!'+ex+'!'+td.eq(4).text());\n      else ucdArray.push(ucd+'!'+j+'!'+it+'!'+ex+\"!\"+td.eq(4).text());\n      crtDepth=depth;\n    }\n  }\n\n  return ucdArray;\n}\n\nfunction ucd2_processing(diva,http){\n  var i;\n  var resource=$(http).find(\"VOTABLE RESOURCE\");\n  if (resource.length==0){ucd2_error(diva,'Internal error: wrong format');return;}\n\n  var tables=resource.find(\"TABLE\");\n  if (tables.length==0) {ucd2_error(diva,'No data');return;}\n\n  var s=ucd2_createArray(diva,tables.eq(0));\n  ucd2_list=new UCD();\n  ucd2_list.setUCDlist(s);\n  ucd2_list.setClickFn('__display_ucd2');\n  ucd2_list.setActionFn('__action_ucd');\n\n  // get the first element which is inside a subnode\n  for (i=1;i<s.length;i++)\n    if (typeof(s[i])!='string') break;\n\n  if (i<s.length){\n     var t=s[i];\n     ucd2_list.display('ucdlistrst',t[0],'ucdtree2',1);\n  }\n  else ucd2_list.display('ucdlistrst','all','ucdtree2',1);\n\n  $(\"<table><tbody></tbody></table>\").appendTo(diva);\n\n  var u=$(\"#ucd2search\");\n  if (u.length==0) return;\n  if (u.hasClass(\"unknownvalue\")) ucdclear();\n}\n\nfunction ucd2_ajax(name,val,rst){\n  var cmd='/viz-bin/ucd2_vot?'+name+'='+val;\n  var diva = $(\"#\"+rst);\n  diva.html(\"<img src='/vizier/VizieR/vizmine/blue.gif'>\");\n  $.ajax({\n    url : cmd,\n    type :'get' ,\n    dataType: 'xml',\n    timeout:5000,\n    success: function(http){\n        ucd2_processing(diva,http);\n        ucd2_lock=0;\n        return;\n        },\n    error:function(request,status, err){\n\tucd2_error(diva,'error retrieveing data',cmd);\n\tucd2_lock=0;\n        }\n    });\n}\n\nfunction ucd2_error(diva,txt,cmd)\n{\n  var e=$(\"<div class='error'/>\").appendTo(diva);\n  if (cmd) e.html(txt+\" : \"+cmd);\n  else e.html(txt);\n}\n\n// function used by the 'advanced form'\nfunction __display_ucd(id,crt){ucd.display(id,crt+\"*\");}\n\n// function used by the 'simple form' \nfunction __display_ucd2(id,crt){ucd2_list.display(id,crt,'ucdtree2',1);}\nfunction __action_ucd(val,str,f){\n  alert(\"Add the definition: \"+str+\" (ucd: \"+val+\")\");\n  ucdadd(val+\"*\",\"&\");\n}\n\nfunction __action_clearucd(){\n  var lucd=document.getElementsByName('-ucd');\n  var i;\n  for (i=0;i<lucd.length;i++){\n    if (lucd[i].type=='text') {\n      var s=lucd[i].id.replace(/ucd_/,'');\n      var e=document.getElementById('tducds'+s);\n      if (e) e.innerHTML='';\n    }\n  }\n}\n\nfunction ucd2_search(value,event){\n  if (!event) var event = window.event;\n  var code=event.keyCode; //IE\n  if (!code) code=event.which;\n\n  if (value.length<2) return;\n  if (code==13 || code==32) {\n    if (ucd2_lock==1) return;\n    if (value.search(/[.*;A-Z]/)>-1) return;\n    ucd2_lock=1;\n\n    ucddisplay('ucdtextsection');\n    var l=$(\"#ucd2core input[name='//ucdform']\");\n    l.attr(\"checked\",false);\n    l.eq(1).attr(\"checked\",true);\n    $(\"#ucdtextsection input\").eq(0).val(value);\n\n    ucd2_ajax(\"-ucd\",value,\"ucdlistrst\");}\n}\n\nfunction ucd2_press(elt,event){\n  if (!event) var event = window.event;\n  var code=event.keyCode; //IE\n  if (!code) code=event.which;\n  if (code==13) {      \n    ucd2_search(elt.value,event);\n    return false;\n  }\n  return true;\n}\n\nfunction ucd2_validation(elt,event) {\n  var ucd = verifyucdsyntax(elt);\n  if (!event) var event = window.event;\n  var code=event.keyCode; //IE\n  if (!code) code=event.which;\n\n  if (! ucd) {\n    if (code==13) {\n      ucd2_search(elt.value,event);\n      return false; \n    }\n  }\n  else{\n    if (code==13) elt.form.submit();\n    else vmine_timer();\n  }\n  return true;\n}\n\n</script>\n\n<div id='ucd2core' class='section hidden'>\n\n<div class=''>\n<img src='/vizier/help.png' title='UCD help' onClick=\"vHelp('1.htx#ucd')\">\n<span class='title CDScol5'>UCD search </span><input type='button' value='clear' onClick='ucdclear();vmine()'>\n<!--input class='ucdvalue' type='text' name='-ucd' value='' onchange=\"verifyucdsyntax(this);vmine()\" onkeyup=\"verifyucdsyntax(this);vmine_timer()\"-->\n<input class='ucdvalue' type='text' id='ucd2search' name='-ucd' value='' onkeypress=\"return ucd2_validation(this,event);\" onkeyup=\"return ucd2_validation(this,event);\">\n<div class='note'>\nSearch catalogs containing a type of columns (UCD). Use the logical characters '|' (<i>or</i>) or '&amp;' (<i>and</i>) to link them together.\n</div>\n\n<div id='ucdsubmenu'>\n<div class='submenu'><input type='radio' name='//ucdform' onClick=\"ucddisplay('ucdexamplesection');vmine();\" checked>Simple examples</div>\n<div class='submenu'><input type='radio' name='//ucdform' onClick=\"ucddisplay('ucdtextsection');vmine();\">Textual search</div>\n<div class='submenu'><input type='radio' name='//ucdform' onClick=\"ucddisplay('ucdtreesection');vmine();\">UCD tree</div>\n</div>\n\n</div>\n\n\n<div id='ucdexamplesection' class='subsection'>\n<div class='help'>\nChoose catalogs containing a type of column by clicking on the belower checkbox\n</div>\n<table cellspacing='0'>\n<tr class='col1'>\n    <td rowspan='3' NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'><span class='hidden ucd'>pos.*</span>Position</td>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>J2000<td class='ucdid'>pos.eq*</td>\n</tr><tr class='col1'>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>Galactic</td><td class='ucdid'>pos.gal*</td>\n</tr><tr class='col1'>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>parallax</td><td class='ucdid'>pos.parallax*</td>\n</tr><tr class='col2'>\n    <td rowspan='3' NOWRAP>Motion</td>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>redshift</td><td class='ucdid'>src.redshift*</td>\n</tr><tr class='col2'>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>radial velocity</td><td class='ucdid'>spect.dopplerVeloc*|phys.veloc*</td>\n</tr><tr class='col2'>\n     <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>proper motion</td><td class='ucdid'>pos.pm*</td>\n</tr><tr class='col3'>\n    <td rowspan='4' NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'><span class='hidden ucd'>phot.flux*</span>Flux</td>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>Radio</td><td class='ucdid'>phot.flux*;em.radio*</td>\n</tr><tr class='col3'>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>IR</td><td class='ucdid'>phot.flux*;em.IR*|phot.flux*;em.mm*</td>\n</tr><tr class='col3'>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>Optic</td><td class='ucdid'>phot.flux*;em.opt*</td>\n</tr><tr class='col3'>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>High energy</td><td class='ucdid'>phot.flux*;em.X-ray*|phot.flux*;em.gamma*</td>\n</tr><tr class='col4'>\n    <td rowspan='5' NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'><span class='hidden ucd'>phot.mag*|phot.color*|phys.magAbs*</span>Magnitude</td>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>magnitude IR (K band) (2mass)</td><td class='ucdid'>phot.mag*;em.IR.K*</td>\n</tr><tr class='col4'>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>magnitude Optical (B band) (SDSS G)</td><td class='ucdid'>phot.mag*;em.opt.B*</td>\n</tr><tr class='col4'>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>color</td><td class='ucdid'>phot.color*</td>\n</tr><tr class='col4'>\n    <td NOWRAP><input type='checkbox' name='//not' onClick='ucdaddexample(this);'>absolute</td><td class='ucdid'>phys.magAbs*</td>\n</tr>\n</table>\n</div>\n\n\n<div id='ucdtextsection' class='subsection hidden'>\n    <!--div class='title CDScol5'>Search for UCD definitions in the VizieR contents</div-->\n    <div class='help'>\n            Enter a free text below to get matching UCD definitions. Next click on the <span class='ucdid'>(definition.text)</span> to select the corresponding UCD.\n    </div>\n    <table><tr>\n        <td><input type='text' id='//ucd2search' onKeyPress='return ucd2_press(this,event);' onKeyUp='ucd2_search(this.value,event)' ></td>\n        <td><div class='note'>Ex: proper motion , redshift</div></td>\n    </tr></table>\n    <div id='ucdlistrst'></div>\n</div>\n\n\n<div id='ucdtreesection' class='subsection hidden'>\n    <div class='help'>\n    Click on <span class='ucdid'>(ucd)</span> to select all definitions containing the ucd (i.e.: *ucd*)\n    </div>\n    <div id='ucd__tree'></div>\n    <script type='text/javascript'>ucd.display('ucd__tree','\".$_[0].\"')</script>\n</div>\n\n\n\n<script type='text/javascript'>ucdinit();</script>\n\n</div>\n<div id='select_media' class='section'><span class='actaref in hidden' href='javascript:void(0)' onClick='show(\"select_media\",\"media\")'> Hide </span><span class='actaref out' href='javascript:void(0)' onClick='show(\"select_media\",\"media\")'> Search for </span> catalogs containing additional data</div>\n<div id='media' class='section hidden'>\n<input type='radio' onChange='vmine()' value='4' name='-media'> time serie \n<input type='radio' onChange='vmine()' value='1' name='-media'> spectrum \n<input type='radio' onChange='vmine()' value='2' name='-media'> images \n<input type='radio' onChange='vmine()' value='8' name='-media'> cube \n<input type='radio' onChange='vmine()' value='256' name='-media'> SED (Spectral Energy Distribution) \n<input type='radio' onChange='vmine()' value='0' name='-media'> none\n</div>\n<div class='section Vbgcol2 Vcol5' id='target'>\n<TABLE WIDTH=\"100%\" BORDER=0 class='vcoo' CELLSPACING=0 CELLPADDING=0>\n<TR><TD ALIGN=LEFT NOWRAP><div class='Vcol5 title'><B>Search by Position across 31460 tables</B></div>\n<TABLE BORDER=0>\n<TR><TD  NOWRAP><FONT SIZE='-1'><B>Target</B> Name (resolved by <a href='https://cds.unistra.fr/cgi-bin/Sesame?'>Sesame</a>) or <B>Position</B>:</FONT><BR><FONT SIZE='-1'><FONT COLOR='#7D26CD'><INPUT TYPE=\"button\" NAME=\"Clear\" VALUE=\" Clear \" onClick=\"clearField(this,'-c',vmine)\"></FONT></FONT><INPUT id='itarget' TYPE=\"text\" NAME=\"-c\" VALUE=\"\" onKeyUp='vmine_timer()'>  <SELECT NAME=\"-c.eq\" onChange='upequinox(this);vmine()'><OPTION SELECTED>J2000<OPTION>B1975<OPTION>B1950<OPTION>B1900<OPTION>B1875<OPTION>B1855<OPTION>Galactic<OPTION>Supergal.<OPTION>Ecl.J2000</SELECT><TD ALIGN=CENTER NOWRAP> <FONT SIZE='-1'>Target dimension:</FONT><BR><INPUT TYPE=\"text\" NAME=\"-c.r\" SIZE=\"3\" VALUE=\"  2\" onKeyUp='vmine_timer()'><SELECT NAME=\"-c.u\" onChange='vmine()'><OPTION>deg<OPTION SELECTED>arcmin<OPTION>arcsec</SELECT></TD><TD ALIGN=RIGHT NOWRAP><BR><div class='findData'><input type='button' title='find data around target (go directly to the Result Page)'name='-4c;' value='Go!' onClick='findDataSubmit(this)'></div><div id='photometry'></div>\n</TD></TR><TR><TD ALIGN=CENTER NOWRAP><span class='note'>NB: The epoch used for the query is the original epoch of the table(s)</span><TD ALIGN=CENTER NOWRAP><FONT SIZE='-1'><INPUT TYPE=\"radio\" NAME=\"-c.geom\" VALUE=\"r\" CHECKED>Radius <INPUT TYPE=\"radio\" NAME=\"-c.geom\" VALUE=\"b\">Box size</FONT></TD></TR></TABLE>\n</TD><TD ALIGN=RIGHT NOWRAP><a href='/vizier/VizieR/vizmine/vizMine.gml'><img src='/vizier/vizMine_icon.gif'></a>\n</TD></TR></TABLE>\n</div>\n</div>\n<div id='submitsection'>\n<div class='left'><a href='/vizier//index.gml'><img src='/vizier/I.png' alt='description' title='VizieR description'>More about VizieR</a></div><div class='right'><span class='unknown'>empty form</span><span id='vmine'></span> <INPUT TYPE=\"submit\" NAME=\"!-2;\" VALUE=\" Find Catalogs \" onClick=\"setViz()\"> <input id='resetb' type='button' title='Reset all' onClick='vmine_off();this.form.reset();return false;'> </div><div class='clear'></div></div>\n<div class='hidden'><a href='/viz-bin/VizieR-trap'>vizier trap</a></div>\n<div id='vminelist' class='section'></div>\n<div id='othersbrowse' class='section'>\n<TABLE WIDTH=\"100%\" BORDER=0 >\n<TR><TD ALIGN=RIGHT NOWRAP><B>Browsing modes:</B> </TD>\n<TD ALIGN=LEFT NOWRAP><a href='/vizier//cats/cats.htx'>Designation</a>, <a href='/vizier//cats/U.htx'>Acronyms</a>, <a href='/vizier//cats/Usage.htx'>Favorites</a>, <a href='/vizier//cats/New.htx'>Dates</a>, <a href='/vizier//cats/M.htx'>Image,spectra</a>, <a href='/vizier//kohonen.htx'>Kohonen</a></TD></TR><TR><TD ALIGN=RIGHT NOWRAP><B>Or list </B> </TD> \n<TD ALIGN=LEFT NOWRAP><a href='/vizier/index.htx#big'>the large surveys</a></TD></TR></TABLE>\n <div><div class='morelinks left' style='font-size:smaller'>\n<div class='title'>Tools related to VizieR</div>\n<ul>\n<li><div class='title'><a href='https://cdsarc.cds.unistra.fr/viz-bin/cat'>Catalogue collection</a> : </div>\n<div class='explain'>Search VizieR catalogues available via various services (FTP, VizieR, TAP, ...)</div>\n</li>\n<li><div class='title'><a href=\"http://cdsportal.u-strasbg.fr\">CDS Portal</a> : </div>\n<div class='explain'>Access CDS data including VizieR, Simbad and Aladin using the CDS portal</div>\n</li>\n<li><div class='title'><a href='https://cdsarc.cds.unistra.fr/assocdata/' alt='VizieR associated data'>Spectra, images in VizieR</a> : </div>\n<div class='explain'>Search Spectra, images in VizieR</div>\n</li>\n<li><div class='title'> <a href='https://vizier.cds.unistra.fr/vizier/sed/'>Photometry viewer</a> : </div>\n<div class='explain'>Plot photometry (sed) including all VizieR</div>\n</li>\n<li><div class='title'><a href='http://tapvizier.cds.unistra.fr/adql/' alt='TAP VizieR'>TAP VizieR</a> : </div>\n<div class='explain'>query VizieR using ADQL (a SQL extension dedicated for astronomy)\n</div>\n</li>\n<li><div class='title'><a href=\"http://cdsxmatch.u-strasbg.fr\">CDS cross-match service</a> : </div>\n<div class='explain'>fast cross-identification between any 2 tables, including VizieR catalogues, SIMBAD\n</div>\n</li>\n</ul>\n</div><div class='clear'> </div></div>\n</div>\n<script type='text/javascript'>setPageError()</script>\n<INPUT TYPE=\"hidden\" NAME=\"-meta.ucd\" VALUE=\"2\">\n<INPUT TYPE=\"hidden\" NAME=\"-usenav\" VALUE=\"1\">\n<INPUT TYPE=\"hidden\" NAME=\"-bmark\" VALUE=\"POST\">\n\n</div>\n</FORM>\n<div id='annotations' class='hidden'>\n<span class='hidden url'>/annotation//annotations/vizierTable//</span></div>\n<SCRIPT language=\"javascript\">if(document.getElementById('progress')) document.getElementById('progress').style.display='none';</SCRIPT>\n<script type='text/javascript'>warningontop();</script>\n<div class='timeelapse'>elapse time 3</div>\n</div></div>\n\n     <!--\n-- #######################################################################\n-- #                                                                     #\n-- #                             CDS FOOTER                              #\n-- #                                                       