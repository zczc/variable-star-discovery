\"/>\n</head>\n<body>\n<div style='display:none;'>\n<h1>VizieR</h1>\n<a href='http://vizier.cfa.harvard.edu/vizier/'>CfA VizieR</a> .\n<a href='http://vizier.nao.ac.jp/vizier/'>ADAC VizieR</a> .\n<!--a href='http://vizier.hia.nrc.ca/vizier/'> CADC VizieR</a> . -->\n<a href='http://archive.ast.cam.ac.uk/vizier/'> Cambridge (UK) VizieR</a> .\n<a href='http://vizier.iucaa.in/vizier/'>IUCAA VizieR</a> .\n<a href='https://vizier.inasan.ru/vizier/'>INASAN VizieR</a> .\n<!--a href='http://data.bao.ac.cn/vizier/'>Beijing (Ch) VizieR</a> .-->\n<!--a href='http://www.ukirt.jach.hawaii.edu/vizier/'>Hawai VizieR</a-->\n</div>\n <!--\n-- #######################################################################\n-- #                                                                     #\n-- #                   CDS TOP NAVIGATION BAR                            #\n-- #                                                                     #\n-- #######################################################################\n-->\n<nav class=\"cds-menu for-vizier\" role=\"menubar\" aria-label=\"CDS services navigation\" data-pagefind-ignore>\n<!-- HEADER: CDS WEBSITE LINK -->\n<header><a href=\"https://cds.unistra.fr\" role=\"menuitem\" aria-label=\"CDS website\"></a></header>\n<!-- MENU CONTENT -->\n<ul role=\"menu\" aria-label=\"CDS services\">\n<!-- List of all services (collapsed on very small screens) -->\n<li class=\"is-collapsed-when-very-small\" role=\"none\">\n<!-- Trigger for showing the menu on very small screens -->\n<span class=\"menu-trigger for-all-services\" tabindex=\"0\" onclick=\"void(0)\" role=\"menuitem\" aria-label=\"List CDS services and more\" aria-haspopup=\"true\" aria-expanded=\"false\"><span>Services</span></span>\n<!-- CDS main services -->\n<ul role=\"menu\" aria-label=\"CDS main services\">\n<li role=\"none\"><a class=\"portal\" href=\"http://cdsportal.u-strasbg.fr\"  role=\"menuitem\" aria-label=\"CDS Portal\"><span></span></a></li>\n<li role=\"none\"><a class=\"simbad\" href=\"https://simbad.idia.ac.za/simbad\"      role=\"menuitem\" aria-label=\"Simbad\"><span></span></a></li>\n<li role=\"none\"><a class=\"vizier\" href=\"http://vizier.idia.ac.za/viz-bin/VizieR\"         role=\"menuitem\" aria-label=\"VizieR\"><span></span></a></li>\n<li role=\"none\"><a class=\"aladin\" href=\"http://aladin.cds.unistra.fr/aladin.gml\"     role=\"menuitem\" aria-label=\"Aladin\"><span></span></a></li>\n<li role=\"none\"><a class=\"xmatch\" href=\"http://cdsxmatch.u-strasbg.fr\"  role=\"menuitem\" aria-label=\"X-Match\"><span></span></a></li>\n<!-- SUB-MENU: Other CDS services -->\n<li role=\"none\">\n<!-- Trigger for showing the sub-menu -->\n<a class=\"menu-trigger for-other-services\" tabindex=\"0\" onclick=\"void(0)\" role=\"menuitem\" aria-label=\"Other resources\" aria-haspopup=\"true\">Others</a>\n<!-- Sub-menu itself -->\n<ul role=\"menu\" aria-label=\"Other resources\">\n<li role=\"none\"><a href=\"https://cds.unistra.fr/cgi-bin/Sesame\" role=\"menuitem\" aria-label=\"Sesame name resolver\">Sesame name resolver</a></li>\n<li role=\"none\"><a href=\"https://cds.unistra.fr/cgi-bin/Dic-Simbad\"            role=\"menuitem\" aria-label=\"Dictionary of nomenclature\">Dictionary of nomenclature</a></li>\n<li role=\"separator\" class=\"divider\" aria-hidden=\"true\"></li>\n<!-- Link: email CDS-Question-->\n<li role=\"none\"><a href=\"mailto:cds-question@unistra.fr\" tabindex=\"0\" role=\"menuitem\" aria-label=\"Contact us\">Contact us</a></li>\n</ul>\n</li>\n</ul>\n</li>\n<!-- Link: CDS help resources -->\n<li role=\"none\"><a class=\"help\" href=\"https://cds.unistra.fr/help\" role=\"menuitem\" aria-label=\"Help resources\"><span>Help</span></a></li>\n</ul>\n</nav>\n<div class=\"cdsPageTitle\"><h1>VizieR <img src='/vizier/welcome/mirror-icone.png' alt='' style='max-width:28px; vertical-align:middle;'/></h1></div>\n<div id='CDSmain'>\n<SCRIPT LANGUAGE=\"JavaScript\" SRC=\"/vizier/lib/jquery.js\"></SCRIPT>\n<div id='VizieR-1'>\n<NOSCRIPT>\n<T