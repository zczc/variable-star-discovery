ssoctype\")) {\r\nif (oForm.elements[i].value != 0) {\r\nsomething = true;\r\nbreak;\r\n}\r\n}\r\nbreak;\r\n}\r\n}\r\nif (! something && (filters[0] == 1 || filters[1] == 1))\r\naccept = confirm(\"Your search terms will almost certainly match a large number of objects. This could take a very long time. Do you want to continue?\");\r\nreturn accept;\r\n}\r\nfunction changeSort(oForm, val) {\r\noForm.order.selectedIndex = val;\r\n}\r\nfunction getCoordinates(oForm) {\r\nif (oForm.ident.value == \"\") {\r\nalert(\"A resolvable name must be specified in order to get coordinates.\");\r\noForm.ident.focus();\r\noForm.ident.select();\r\nreturn;\r\n}\r\noForm.getCoordinates.value = 1;\r\noForm.action = \"index.php?view=search.top\";\r\noForm.submit();\r\n}\r\nfunction specialSearch(oForm) {\r\nvar url = oForm.special.options[oForm.special.selectedIndex].value;\r\nwindow.location = url;\r\n}\r\n\r\nvar urlCampaigns = new Array();\r\nurlCampaigns[0] = 'javascript:void();';\r\nurlCampaigns[17] = 'http://www.britastro.org/vss/rop.html';\nurlCampaigns[2] = 'http://www.aavso.org/aavso-binocular-program';\nurlCampaigns[19] = 'https://www.aavso.org/aavso-brite-targets';\nurlCampaigns[15] = 'http://www.aavso.org/aavso-alert-notice-482';\nurlCampaigns[1] = 'http://www.aavso.org/aavso-alert-notice-471';\nurlCampaigns[12] = 'http://www.aavso.org/observing-campaigns';\nurlCampaigns[5] = 'https://sites.google.com/site/aavsocvsection/aavso-legacy-cvs';\nurlCampaigns[6] = 'https://www.aavso.org/aavso-legacy-lpv-program';\nurlCampaigns[20] = 'https://www.aavso.org/aavso-long-period-variable-section';\nurlCampaigns[9] = 'https://www.aavso.org/lpv-double-trouble-campaign-0';\nurlCampaigns[10] = 'https://www.aavso.org/lpv-humps';\nurlCampaigns[7] = 'https://www.aavso.org/lpv-section-file-downloads';\nurlCampaigns[21] = 'https://www.aavso.org/aavso-long-period-variable-section';\nurlCampaigns[4] = 'http://homepage.usask.ca/~ges125/AAVSO_HMXB_Charts.html';\nurlCampaigns[16] = 'http://www.stsci.d